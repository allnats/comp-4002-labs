{
  "name": "pixell-river",
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "description": "comp-4002 labs",
  "main": "index.js",
  "scripts": {
    "build:frontend": "npm run build --workspace=@pixell-river/frontend",
    "build:backend": "npm run build --workspace=@pixell-river/backend",
    "start:frontend": "npm run dev --workspace=@pixell-river/frontend",
    "start:backend": "npm run dev --workspace=@pixell-river/backend",
    "dev": "concurrently \"npm:start:frontend\" \"npm:start:backend\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allnats/comp-4002-labs.git"
  },
  "author": "Allendale Nato",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/allnats/comp-4002-labs/issues"
  },
  "homepage": "https://github.com/allnats/comp-4002-labs#readme",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^6.0.3"
  }
}
